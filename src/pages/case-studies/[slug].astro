---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleContent from '../../components/ArticleContent.astro';
import RichText from '../../components/RichText.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import { loadQuery } from '../../sanity/lib/load-query';
import { IMAGE, type SanityImage } from '../../sanity/lib/image';
import { RICH_TEXT } from '../../sanity/lib/rich-text';
import type { PortableTextBlock, Seo } from '../../sanity/lib/types';

interface CaseStudy {
	title: string;
	slug: string;
	summary?: string;
	client: string;
	location: string;
	value?: string;
	logo?: SanityImage;
	content?: PortableTextBlock[];
	testimonial?: { quote?: string; name?: string; role?: string; rating?: number };
	seo?: Seo;
}

export async function getStaticPaths() {
	const { data } = await loadQuery<CaseStudy[]>({
		query: `*[_type == "caseStudy" && defined(slug.current)]{
			title,
			"slug": slug.current,
			summary,
			client,
			location,
			value,
			logo${IMAGE},
			content${RICH_TEXT},
			testimonial,
			seo{ ..., ogImage${IMAGE} }
		}`,
	});
	return (data ?? []).map((caseStudy) => ({ params: { slug: caseStudy.slug }, props: { caseStudy } }));
}

const { caseStudy } = Astro.props as { caseStudy: CaseStudy };
const { title, summary, client, location, value, logo, content, testimonial, seo } = caseStudy;

const details = [
	{ label: 'Client', value: client },
	{ label: 'Location', value: location },
	...(value ? [{ label: 'Value', value }] : []),
];
---

<Layout
	title={seo?.metaTitle ?? `${title} — BSW Heating`}
	description={seo?.metaDescription ?? summary}
	image={seo?.ogImage?.url}>
	<ArticleHero tag={`Case Study · ${location}`} title={title} summary={summary}>
		<dl class='grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-5.25 w-full max-w-199.5 mt-9.5 text-left'>
			{
				details.map((detail) => (
					<div class='bg-bsw-navy rounded-2xl px-6.5 py-5 flex flex-col gap-1.5'>
						<dt class='uppercase-tag text-text-secondary-dark'>{detail.label}</dt>
						<dd class='font-semibold leading-5.5 text-white'>{detail.value}</dd>
					</div>
				))
			}
		</dl>
	</ArticleHero>

	<article class='article-wrapper pt-15 pb-20 md:pb-25 flex flex-col gap-10'>
		{
			logo && (
				<Image
					src={logo.url}
					alt={logo.alt ?? ''}
					width={Math.round((logo.width * 114) / logo.height)}
					height={114}
					class='h-14.25 w-auto self-start'
				/>
			)
		}

		<ArticleContent>
			<RichText value={content} />
		</ArticleContent>

		{
			testimonial?.quote && testimonial.name && (
				<div class='mt-2.5'>
					<TestimonialCard
						quote={testimonial.quote}
						name={testimonial.name}
						role={testimonial.role}
						rating={testimonial.rating}
					/>
				</div>
			)
		}
	</article>
</Layout>
