---
import { PortableText } from 'astro-portabletext';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ImageTextSection from '../../components/ImageTextSection.astro';
import StatsSection from '../../components/about-us/StatsSection.astro';
import ValuesSection from '../../components/about-us/ValuesSection.astro';
import TeamSection from '../../components/about-us/TeamSection.astro';
import ContactFormSection from '../../components/home/ContactFormSection.astro';
import { loadQuery } from '../../sanity/lib/load-query';
import { IMAGE } from '../../sanity/lib/image';
import type { ImageTextSection as Section, PageHero as Hero, Seo } from '../../sanity/lib/types';

interface AboutPage {
	hero?: Hero;
	introSection?: Section;
	stats?: { _key: string; value: string; label?: string }[];
	valuesHeading?: string;
	values?: { _key: string; title: string; description?: string }[];
	customerServiceSection?: Section;
	teamHeading?: string;
	teamText?: string;
	seo?: Seo;
}

const { data: page } = await loadQuery<AboutPage>({
	query: `*[_id == "aboutPage"][0]{
		...,
		hero{ ..., image${IMAGE} },
		introSection{ ..., image${IMAGE} },
		customerServiceSection{ ..., image${IMAGE} },
		seo{ ..., ogImage${IMAGE} }
	}`,
});
---

<Layout
	title={page?.seo?.metaTitle ?? 'About Us'}
	description={page?.seo?.metaDescription}
	image={page?.seo?.ogImage?.url}>
	<PageHero title={page?.hero?.title ?? 'About Us'} subtitle={page?.hero?.subtitle} image={page?.hero?.image} />

	{
		page?.introSection && (
			<ImageTextSection
				tag={page.introSection.tag}
				heading={page.introSection.heading}
				image={page.introSection.image}>
				{page.introSection.text && <PortableText value={page.introSection.text} />}
			</ImageTextSection>
		)
	}

	<StatsSection stats={page?.stats} />
	<ValuesSection heading={page?.valuesHeading} values={page?.values} />

	{
		page?.customerServiceSection && (
			<ImageTextSection
				tag={page.customerServiceSection.tag}
				heading={page.customerServiceSection.heading}
				image={page.customerServiceSection.image}
				imagePosition='right'
				class='pt-5 pb-15 md:pt-6.25 md:pb-25'>
				{page.customerServiceSection.text && <PortableText value={page.customerServiceSection.text} />}
			</ImageTextSection>
		)
	}

	<TeamSection heading={page?.teamHeading} text={page?.teamText} />
	<ContactFormSection />
</Layout>
