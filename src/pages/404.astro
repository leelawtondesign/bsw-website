---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout title='Page Not Found — BSW Heating' description='The page you were looking for could not be found.'>
	<section class='content-wrapper pt-40 pb-20 md:pt-48 md:pb-32 text-center'>
		<p class='uppercase-tag text-bsw-orange-text pb-4'>404 Error</p>
		<h1 class='text-text-primary mb-4'>Page not found</h1>
		<p class='text-text-secondary max-w-md mx-auto mb-8'>
			Sorry, the page you're looking for doesn't exist or has been moved.
		</p>
		<Button href='/'>Back to home</Button>
	</section>
</Layout>
