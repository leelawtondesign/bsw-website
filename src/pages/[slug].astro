---
// Legal pages (privacy policy, modern slavery policy etc.) live at the site root
import Layout from '../layouts/Layout.astro';
import ArticleHero from '../components/ArticleHero.astro';
import ArticleContent from '../components/ArticleContent.astro';
import RichText from '../components/RichText.astro';
import { loadQuery } from '../sanity/lib/load-query';
import { IMAGE } from '../sanity/lib/image';
import { RICH_TEXT } from '../sanity/lib/rich-text';
import type { PortableTextBlock, Seo } from '../sanity/lib/types';

interface LegalPage {
	title: string;
	slug: string;
	content?: PortableTextBlock[];
	lastUpdated?: string;
	seo?: Seo;
}

export async function getStaticPaths() {
	const { data } = await loadQuery<LegalPage[]>({
		query: `*[_type == "legalPage" && defined(slug.current)]{
			title,
			"slug": slug.current,
			content${RICH_TEXT},
			lastUpdated,
			seo{ ..., ogImage${IMAGE} }
		}`,
	});
	return (data ?? []).map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: LegalPage };

const formattedDate = page.lastUpdated
	? new Date(page.lastUpdated).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
	: null;
---

<Layout title={page.seo?.metaTitle ?? page.title} description={page.seo?.metaDescription} image={page.seo?.ogImage?.url}>
	<ArticleHero tag={formattedDate ? `Last updated ${formattedDate}` : 'BSW Heating'} title={page.title} />

	<article class='article-wrapper pt-15 pb-20 md:pb-25'>
		<ArticleContent>
			<RichText value={page.content} />
		</ArticleContent>
	</article>
</Layout>
