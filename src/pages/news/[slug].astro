---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleContent from '../../components/ArticleContent.astro';
import RichText from '../../components/RichText.astro';
import { loadQuery } from '../../sanity/lib/load-query';
import { IMAGE, type SanityImage } from '../../sanity/lib/image';
import { RICH_TEXT } from '../../sanity/lib/rich-text';
import type { PortableTextBlock, Seo } from '../../sanity/lib/types';

interface NewsArticle {
	title: string;
	slug: string;
	summary?: string;
	articleDate: string;
	featureImage?: SanityImage;
	content?: PortableTextBlock[];
	seo?: Seo;
}

export async function getStaticPaths() {
	const { data } = await loadQuery<NewsArticle[]>({
		query: `*[_type == "newsArticle" && defined(slug.current)]{
			title,
			"slug": slug.current,
			summary,
			articleDate,
			featureImage${IMAGE},
			content${RICH_TEXT},
			seo{ ..., ogImage${IMAGE} }
		}`,
	});
	return (data ?? []).map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: NewsArticle };
const { title, summary, articleDate, featureImage, content, seo } = article;

const formattedDate = new Date(articleDate).toLocaleDateString('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric',
});
---

<Layout
	title={seo?.metaTitle ?? `${title} — BSW Heating`}
	description={seo?.metaDescription ?? summary}
	image={seo?.ogImage?.url ?? featureImage?.url}>
	<ArticleHero tag={`Posted ${formattedDate}`} title={title} summary={summary} />

	<article class='article-wrapper pt-15 pb-20 md:pb-25 flex flex-col gap-12.5'>
		<ArticleContent>
			<RichText value={content} />
		</ArticleContent>

		{
			featureImage && (
				<Image
					src={featureImage.url}
					width={featureImage.width}
					height={featureImage.height}
					alt={featureImage.alt ?? ''}
					widths={[342, 684]}
					sizes='342px'
					class='w-full max-w-85.5 aspect-342/204 object-cover rounded-xl'
				/>
			)
		}
	</article>
</Layout>
