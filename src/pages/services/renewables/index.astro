---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import ServiceIntroSection from '../../../components/services/ServiceIntroSection.astro';
import ContractWinsSection from '../../../components/services/ContractWinsSection.astro';
import ContactFormSection from '../../../components/home/ContactFormSection.astro';
import ServiceImage from '../../../assets/services/renewables.webp';

const reasons = [
	{
		title: 'Heat Pump Specialists',
		description: 'Expert design and installation of advanced heat pump systems for lasting performance.',
	},
	{
		title: 'Heat Network Solutions',
		description: 'Delivering efficient heat network projects that support long-term decarbonisation goals.',
	},
	{
		title: 'Complete Lifecycle Support',
		description: 'From design and installation to ongoing maintenance, we keep systems performing efficiently.',
	},
	{
		title: 'Sustainable Energy Experts',
		description: 'Helping public and private sector clients transition to cleaner, lower-carbon heating solutions.',
	},
];
---

<Layout
	title='Renewable Technologies — BSW Heating'
	description='Heat pump, heat network and low-carbon heating design, installation and maintenance across the South East.'>
	<PageHero
		title='Renewable Technologies'
		subtitle='Lorem ipsum dolor sit amet consectetur. Consectetur.'
	/>
	<ServiceIntroSection
		tag='Renewable Technologies'
		heading='Powering a More Sustainable Future'
		intro='Designing, installing and maintaining renewable heating solutions that reduce carbon emissions and improve energy efficiency across the South East.'
		image={ServiceImage}
		imageAlt='House with solar panels and an air source heat pump'
		reasons={reasons}
	/>
	<ContractWinsSection />
	<ContactFormSection />
</Layout>
