---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import ServiceIntroSection from '../../../components/services/ServiceIntroSection.astro';
import ContractWinsSection from '../../../components/services/ContractWinsSection.astro';
import ContactFormSection from '../../../components/home/ContactFormSection.astro';
import ServiceImage from '../../../assets/services/mechanical_electrical.webp';

const reasons = [
	{
		title: 'Design & Build Expertise',
		description: 'Complete building services packages, from initial design through to final installation.',
	},
	{
		title: 'Large-Scale Installations',
		description: 'Experienced in delivering energy centres, plant rooms and district heating infrastructure.',
	},
	{
		title: 'Public & Private Sector',
		description: 'Trusted by commercial organisations and public sector clients across the South East.',
	},
	{
		title: 'End-to-End Project Delivery',
		description: 'Managing every stage of your project with quality, efficiency and technical expertise.',
	},
];
---

<Layout
	title='Mechanical & Electrical Projects — BSW Heating'
	description='Mechanical and electrical project delivery across the South East, from energy centres and plant rooms to district heating schemes.'>
	<PageHero
		title='Mechanical & Electrical Projects'
		subtitle='Lorem ipsum dolor sit amet consectetur. Consectetur.'
	/>
	<ServiceIntroSection
		tag='Mechanical & Electrical Projects'
		heading='Complete M&E Solutions, Designed & Delivered'
		intro='From energy centres and commercial plant rooms to district heating schemes, we provide complete mechanical and electrical solutions across the South East.'
		image={ServiceImage}
		imageAlt='Commercial plant room pipework and boilers installed by BSW'
		reasons={reasons}
	/>
	<ContractWinsSection />
	<ContactFormSection />
</Layout>
