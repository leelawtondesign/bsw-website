---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	name: string;
	logo: ImageMetadata;
}

const { name, logo } = Astro.props;
---

<div class='bg-white rounded-[10px] shadow-card w-63 shrink-0 px-10.75 py-6 flex items-center justify-center'>
	<Image
		src={logo}
		alt={name}
		height={140}
		class='h-17.5 w-41.25 object-contain'
	/>
</div>
