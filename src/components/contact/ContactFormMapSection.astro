---
import ContactForm from '../ContactForm.astro';
import { MAP_EMBED_URL } from '../../consts';
---

<section class='content-wrapper py-15 md:py-25 scroll-m-10' id='contact-form-section'>
	<div class='grid grid-cols-12 gap-y-10 md:gap-x-10 items-start'>
		<!-- Left: map -->
		<div class='col-span-12 md:col-span-6 h-80 md:h-120 rounded-2xl overflow-hidden border border-grey-200 bg-grey-50'>
			<iframe
				src={MAP_EMBED_URL}
				title='Map showing the BSW Heating office in Kenley, Surrey'
				loading='lazy'
				referrerpolicy='no-referrer-when-downgrade'
				class='w-full h-full border-0'>
			</iframe>
		</div>

		<!-- Right: form -->
		<div class='col-span-12 md:col-span-6'>
			<ContactForm variant='light' />
		</div>
	</div>
</section>
