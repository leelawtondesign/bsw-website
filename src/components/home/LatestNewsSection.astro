---
import NewsCard from '../NewsCard.astro';
import { loadQuery } from '../../sanity/lib/load-query';
import { IMAGE, type SanityImage } from '../../sanity/lib/image';

interface Article {
	_id: string;
	title: string;
	summary?: string;
	articleDate?: string;
	slug: string;
	image?: SanityImage;
}

const { data } = await loadQuery<Article[]>({
	query: `*[_type == "newsArticle"] | order(articleDate desc) [0...3] {
		_id,
		title,
		summary,
		articleDate,
		"slug": slug.current,
		"image": featureImage${IMAGE}
	}`,
});

const articles = data ?? [];
---

{
	articles.length > 0 && (
		<section class='content-wrapper py-15 md:py-17.5'>
			<div class='text-center mb-9.75'>
				<h2 class='text-text-primary'>News</h2>
			</div>

			<!-- Swipeable row on phones, grid from md up -->
			<div class='flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-px-5 -mx-5 px-5 [scrollbar-width:none] md:grid md:grid-cols-12 md:gap-x-5.5 md:overflow-visible md:mx-0 md:px-0'>
				{articles.map((article) => (
					<div class='snap-start shrink-0 w-4/5 md:w-auto md:col-span-4'>
						<NewsCard
							title={article.title}
							summary={article.summary}
							articleDate={article.articleDate}
							image={article.image}
							slug={article.slug}
						/>
					</div>
				))}
			</div>
		</section>
	)
}
