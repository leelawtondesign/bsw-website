---
import { Image } from 'astro:assets';
import { BookCheck, Flame, Toolbox } from '@lucide/astro';
import PlantRoom from '../../assets/home/plant_room.webp';

const highlights = [
	{ icon: Flame, text: 'Domestic & commercial heating solutions' },
	{ icon: Toolbox, text: 'Reliable servicing, repairs and maintenance' },
	{ icon: BookCheck, text: 'Trusted by housing, education and healthcare sectors' },
];
---

<section class='content-wrapper py-15 md:py-25'>
	<div class='grid grid-cols-12 gap-y-10 md:gap-x-10 md:gap-y-0 lg:gap-x-0 items-stretch'>
		<!-- Left: image -->
		<div class='col-span-12 md:col-span-6 lg:col-span-5 rounded-[28px] overflow-hidden aspect-455/508 md:aspect-auto'>
			<Image
				src={PlantRoom}
				alt='Commercial boiler plant room installed by BSW Heating'
				widths={[480, 960, 1440]}
				sizes='(min-width: 1024px) 455px, (min-width: 768px) 50vw, 100vw'
				quality={80}
				class='w-full h-full object-cover object-[45%_center]'
			/>
		</div>

		<!-- Right: copy + highlights -->
		<div class='col-span-12 md:col-span-6 lg:col-start-7 lg:col-span-6 flex flex-col items-start gap-6.5 md:py-2.5'>
			<p class='uppercase-tag text-bsw-orange-text'>Domestic &amp; Commercial Heating Specialists</p>
			<h2 class='text-text-primary'>Award-winning heating, servicing and maintenance since day one</h2>
			<p class='text-text-primary max-w-114'>
				BSW Heating Limited provides professional heating installation, servicing and maintenance across the South East
				for homes, businesses and public sector organisations.
			</p>

			<ul class='w-full max-w-115'>
				{
					highlights.map((item) => (
						<li class='flex items-center gap-1.5 px-0.5 py-4.5 border-b border-grey-100 last:border-b-0 last:pb-0'>
							<item.icon size={29} stroke-width={1.25} class='shrink-0 text-bsw-orange' />
							<span>{item.text}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
