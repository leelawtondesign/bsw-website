---
import { Image } from 'astro:assets';
import { BookCheck, Flame, Toolbox } from '@lucide/astro';
import { PortableText } from 'astro-portabletext';
import type { ImageTextSection } from '../../sanity/lib/types';

interface Props {
	section?: ImageTextSection;
	highlights?: { _key: string; icon?: string; text: string }[];
}

const { section, highlights = [] } = Astro.props;

const icons: Record<string, typeof Flame> = { flame: Flame, toolbox: Toolbox, 'book-check': BookCheck };
---

<section class='content-wrapper py-15 md:py-25'>
	<div class='grid grid-cols-12 gap-y-10 md:gap-x-10 md:gap-y-0 lg:gap-x-0 items-stretch'>
		<!-- Left: image -->
		<div class='col-span-12 md:col-span-6 lg:col-span-5 rounded-2xl overflow-hidden aspect-455/508 md:aspect-auto'>
			{section?.image && <Image
				src={section.image.url}
				width={section.image.width}
				height={section.image.height}
				alt={section.image.alt ?? ''}
				widths={[480, 960, 1440]}
				sizes='(min-width: 1024px) 455px, (min-width: 768px) 50vw, 100vw'
				quality={80}
				class='w-full h-full object-cover object-[45%_center]'
			/>}
		</div>

		<!-- Right: copy + highlights -->
		<div class='col-span-12 md:col-span-6 lg:col-start-7 lg:col-span-6 flex flex-col items-start gap-6.5 md:py-2.5'>
			{section?.tag && <p class='uppercase-tag text-bsw-orange-text'>{section.tag}</p>}
			{section?.heading && <h2 class='text-text-primary'>{section.heading}</h2>}
			{
				section?.text && (
					<div class='text-text-primary max-w-114 flex flex-col gap-4'>
						<PortableText value={section.text} />
					</div>
				)
			}

			<ul class='w-full max-w-115'>
				{
					highlights.map((item) => {
						const Icon = icons[item.icon ?? ''] ?? Flame;
						return (
						<li class='flex items-center gap-1.5 px-0.5 py-4.5 border-b border-grey-100 last:border-b-0 last:pb-0'>
							<Icon size={29} stroke-width={1.25} class='shrink-0 text-bsw-orange' />
							<span>{item.text}</span>
						</li>
						);
					})
				}
			</ul>
		</div>
	</div>
</section>
