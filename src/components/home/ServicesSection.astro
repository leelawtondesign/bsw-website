---
import ServiceCard from '../ServiceCard.astro';
import { Building, House, SolarPanel, TruckElectric } from '@lucide/astro';
---

<section class='bg-bsw-navy mx-4 rounded-2xl overflow-hidden pt-15 pb-15 md:pt-21.25 md:pb-25'>
	<div class='content-wrapper'>
		<h2 class='text-center text-white mb-9.75'>Our Services</h2>

		<!-- Swipeable row on phones, grid from sm up -->
		<div
			class='flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-px-5 -mx-5 px-5 [scrollbar-width:none] sm:grid sm:grid-cols-12 sm:gap-5.25 sm:overflow-visible sm:mx-0 sm:px-0'>
			<div class='snap-start shrink-0 w-4/5 sm:w-auto sm:col-span-6 lg:col-span-3'>
				<ServiceCard
					title='Domestic Maintenance & Installations'
					description='Servicing, repairs and installations for housing associations and residents.'
					href='/services/domestic'>
					<House size={31} />
				</ServiceCard>
			</div>
			<div class='snap-start shrink-0 w-4/5 sm:w-auto sm:col-span-6 lg:col-span-3'>
				<ServiceCard
					title='Commercial Maintenance & Installations'
					description='Planned and reactive maintenance contracts for commercial clients.'
					href='/services/commercial'>
					<Building size={31} />
				</ServiceCard>
			</div>
			<div class='snap-start shrink-0 w-4/5 sm:w-auto sm:col-span-6 lg:col-span-3'>
				<ServiceCard
					title='Mechanical & electrical projects'
					description='Mechanical and electrical project delivery from design through to handover.'
					href='/services/mechanical-electrical'>
					<TruckElectric size={31} />
				</ServiceCard>
			</div>
			<div class='snap-start shrink-0 w-4/5 sm:w-auto sm:col-span-6 lg:col-span-3'>
				<ServiceCard
					title='Renewable Technologies'
					description='Heat pumps and low-carbon heating to support net-zero targets.'
					href='/services/renewables'>
					<SolarPanel size={31} />
				</ServiceCard>
			</div>
		</div>
	</div>
</section>
