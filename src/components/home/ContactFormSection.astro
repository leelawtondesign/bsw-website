---
import { Clock, Mail, MapPin, Phone } from '@lucide/astro';
import ContactForm from '../ContactForm.astro';
import { getSiteSettings, telHref } from '../../sanity/lib/globals';

const { phone, email, addressLine1, addressLine2, openingHours, contactSection } = await getSiteSettings();

const details = [
	phone && { icon: Phone, label: 'Call us', value: phone, href: telHref(phone) },
	email && { icon: Mail, label: 'Email us', value: email, href: `mailto:${email}` },
	addressLine1 && { icon: MapPin, label: 'Visit our office', value: `${addressLine1} ${addressLine2 ?? ''}`.trim() },
	openingHours && { icon: Clock, label: 'Opening hours', value: openingHours },
].filter((detail) => !!detail) as { icon: typeof Phone; label: string; value: string; href?: string }[];
---

<section class='content-wrapper py-15 md:py-17.5 scroll-m-10' id='contact-form-section'>
	<div class='grid grid-cols-12 gap-y-10 md:gap-x-6.5 items-start'>
		<!-- Left: intro + contact details -->
		<div class='col-span-12 md:col-span-6 flex flex-col items-start gap-3'>
			<h2 class='text-text-primary'>{contactSection?.heading ?? 'Any questions? Just ask'}</h2>
			{contactSection?.text && <p class='text-text-primary max-w-114'>{contactSection.text}</p>}

			<ul class='flex flex-col gap-5 mt-7'>
				{
					details.map((detail) => (
						<li class='flex items-start gap-4'>
							<span class='inline-flex items-center justify-center p-2.5 rounded-xl bg-primary-100 text-bsw-orange-text shrink-0'>
								<detail.icon size={22} stroke-width={1.5} />
							</span>
							<span class='flex flex-col'>
								<span class='text-sm text-text-secondary'>{detail.label}</span>
								{detail.href ? (
									<a href={detail.href} class='font-semibold text-text-primary hover:text-bsw-orange-text transition-colors'>
										{detail.value}
									</a>
								) : (
									<span class='font-semibold text-text-primary'>{detail.value}</span>
								)}
							</span>
						</li>
					))
				}
			</ul>
		</div>

		<!-- Right: form card -->
		<div class='col-span-12 md:col-span-6'>
			<ContactForm />
		</div>
	</div>
</section>
