---
import CustomerCard from '../CustomerCard.astro';
import { loadQuery } from '../../sanity/lib/load-query';
import { IMAGE, type SanityImage } from '../../sanity/lib/image';

interface Customer {
	name: string;
	logo: SanityImage;
}

const { data } = await loadQuery<Customer[]>({
	query: `*[_type == "customer" && defined(logo.asset)] | order(orderRank) { name, logo${IMAGE} }`,
});

const customers = data ?? [];

// Repeat the logos so a single set always overflows the track
const minCards = 8;
const copies = Math.max(1, Math.ceil(minCards / Math.max(customers.length, 1)));
const row = Array.from({ length: copies }, () => customers).flat();

const cardWidth = 273;
const duration = Math.round((row.length * cardWidth) / 40);
---

{customers.length > 0 && (
<section class='bg-light-grey-bg mx-4 rounded-2xl overflow-hidden py-15 md:py-21.25'>
	<div class='content-wrapper text-center mb-6.5'>
		<h2 class='text-text-primary'>Trusted by</h2>
	</div>

	<div class='content-wrapper'>
		<div class='marquee-container'>
			<div class='marquee-row' style={`--duration:${duration}s;`}>
				{row.map((c) => <CustomerCard name={c.name} logo={c.logo} />)}
				<span aria-hidden='true' class='contents'>
					{row.map((c) => <CustomerCard name={c.name} logo={c.logo} />)}
				</span>
			</div>
		</div>
	</div>
</section>
)}

<style>
	.marquee-container {
		overflow: hidden;
		padding: 22px 0;
		-webkit-mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
		mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
	}

	.marquee-row {
		display: flex;
		gap: 21px;
		width: max-content;
		will-change: transform;
		transform: translateZ(0);
		animation: marquee var(--duration) linear infinite;
	}

	.marquee-container:hover .marquee-row {
		animation-play-state: paused;
	}

	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			/* Half the row plus half a gap keeps the loop seamless */
			transform: translateX(calc(-50% - 10.5px));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-row {
			animation: none;
		}
	}
</style>
