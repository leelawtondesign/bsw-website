---
import { ArrowRight } from '@lucide/astro';

interface Props {
	text?: string;
	ariaLabel?: string;
	color?: 'orange' | 'white';
	href?: string;
	target?: '_blank' | '_self' | '_parent' | '_top';
	class?: string;
}

const { text = 'Learn More', ariaLabel, color = 'orange', href, target, class: className = '' } = Astro.props;

const colorMap = {
	orange: { text: 'var(--color-bsw-orange-text)', border: 'var(--color-bsw-orange)', hover: 'var(--color-text-primary)' },
	white: { text: 'var(--color-white)', border: 'var(--color-white)', hover: 'var(--color-primary-100)' },
};

const colors = colorMap[color];
const Tag = href ? 'a' : 'span';
---

<Tag
	href={href}
	aria-label={ariaLabel}
	target={target}
	rel={target === '_blank' ? 'noopener noreferrer' : undefined}
	class={`link-arrow inline-flex items-center gap-1.75 py-1.5 border-b-[1.5px] text-xs leading-4 font-bold transition-all duration-200 ${className}`}
	style={`--link-color: ${colors.text}; --link-border: ${colors.border}; --link-hover: ${colors.hover};`}>
	{text}
	<ArrowRight size={15} stroke-width={1.5} />
</Tag>

<style>
	.link-arrow {
		color: var(--link-color);
		border-color: var(--link-border);
	}
	.link-arrow:hover {
		gap: 0.625rem;
		color: var(--link-hover);
		border-color: var(--link-hover);
	}
</style>
