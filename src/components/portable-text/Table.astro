---
import type { Props as PortableTextProps } from 'astro-portabletext/types';

// @sanity/table value. The first row is treated as the header.
type Props = PortableTextProps<{ _type: string; rows?: { _key: string; cells?: string[] }[] }>;

const [header, ...rows] = Astro.props.node.rows ?? [];
---

{
	header && (
		<div class='overflow-x-auto'>
			<table class='w-full text-left text-sm border-collapse'>
				<thead>
					<tr>
						{header.cells?.map((cell) => (
							<th class='font-semibold border-b border-grey-200 px-3 py-2.5'>{cell}</th>
						))}
					</tr>
				</thead>
				<tbody>
					{rows.map((row) => (
						<tr>
							{row.cells?.map((cell) => (
								<td class='border-b border-grey-100 px-3 py-2.5'>{cell}</td>
							))}
						</tr>
					))}
				</tbody>
			</table>
		</div>
	)
}
