---
import type { Mark, Props as PortableTextProps } from 'astro-portabletext/types';

type Props = PortableTextProps<Mark<{ href?: string; newTab?: boolean }>>;

const { href, newTab } = Astro.props.node.markDef;
---

<a href={href} target={newTab ? '_blank' : undefined} rel={newTab ? 'noopener' : undefined}><slot /></a>
