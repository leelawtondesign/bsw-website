---
import type { SanityImage } from '../sanity/lib/image';
import { Image } from 'astro:assets';

interface Props {
	title: string;
	description?: string;
	image?: SanityImage;
}

const { title, description, image } = Astro.props;
---

<div
	class='border border-grey-200 rounded-2xl px-6 py-10 md:px-16 md:py-13 flex flex-col md:flex-row items-center gap-8 md:gap-11.75'>
	<div class='size-40 md:size-52.5 shrink-0 overflow-hidden'>
		{image && <Image src={image.url} width={image.width} height={image.height} alt={image.alt ?? ''} class='w-full h-full object-cover object-left-top' />}
	</div>
	<div class='flex flex-col gap-5.5 text-text-primary'>
		<h3 class='text-h4'>{title}</h3>
		<p class='text-lg leading-7'>{description}</p>
	</div>
</div>
