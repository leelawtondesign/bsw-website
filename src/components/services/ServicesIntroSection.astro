---
import { Check } from '@lucide/astro';

interface Props {
	tag?: string;
	heading?: string;
	text?: string;
	expertiseHeading?: string;
	expertise?: string[];
}

const { tag, heading, text, expertiseHeading = 'We are experts in', expertise = [] } = Astro.props;
---

<section class='content-wrapper py-15 md:py-25'>
	<div class='grid grid-cols-12 gap-y-10 md:gap-x-10 lg:gap-x-16.25 items-start'>
		<!-- Left: copy -->
		<div class='col-span-12 md:col-span-5 flex flex-col items-start gap-5.5'>
			{tag && <p class='uppercase-tag text-bsw-orange-text'>{tag}</p>}
			{heading && <h2 class='text-text-primary'>{heading}</h2>}
			{text && <p class='text-text-primary text-lg leading-7 whitespace-pre-line'>{text}</p>}
		</div>

		<!-- Right: expertise checklist -->
		{
			expertise.length > 0 && (
				<div class='col-span-12 md:col-span-7 bg-light-grey-bg rounded-2xl px-7 py-9 md:px-10 md:py-11'>
					<h3 class='text-text-primary mb-6'>{expertiseHeading}</h3>
					<ul class='grid grid-cols-1 sm:grid-cols-2 gap-x-6.5 gap-y-4'>
						{expertise.map((item) => (
							<li class='flex items-start gap-3 text-text-primary'>
								<span class='inline-flex items-center justify-center size-5.5 rounded-full bg-bsw-orange text-white shrink-0 mt-0.5'>
									<Check size={13} stroke-width={2.5} />
								</span>
								{item}
							</li>
						))}
					</ul>
				</div>
			)
		}
	</div>
</section>
