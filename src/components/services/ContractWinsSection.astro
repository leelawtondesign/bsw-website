---
import ContractCard from '../ContractCard.astro';
import type { SanityImage } from '../../sanity/lib/image';

interface Props {
	caseStudies: {
		client: string;
		location: string;
		summary?: string;
		slug: string;
		logo?: SanityImage;
	}[];
}

const { caseStudies } = Astro.props;
---

{
	caseStudies.length > 0 && (
		<section class='content-wrapper pb-5'>
			<div class='text-center mb-9.75'>
				<h2 class='text-text-primary'>Contract Wins</h2>
			</div>

			<div class='grid grid-cols-12 gap-y-7.5 md:gap-x-7.5'>
				{caseStudies.map((caseStudy) => (
					<div class='col-span-12 md:col-span-6 lg:col-span-4'>
						<ContractCard
							client={caseStudy.client}
							location={caseStudy.location}
							summary={caseStudy.summary}
							logo={caseStudy.logo}
							href={`/case-studies/${caseStudy.slug}`}
						/>
					</div>
				))}
			</div>
		</section>
	)
}
