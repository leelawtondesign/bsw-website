---
import { Image } from 'astro:assets';
import BswLogo from '../assets/brand/bsw_logo_white.svg';
import { getFooter, getSiteSettings, telHref } from '../sanity/lib/globals';

const today = new Date();

const [settings, footer] = await Promise.all([getSiteSettings(), getFooter()]);
const { addressLine1 = '', addressLine2 = '', phone, email, companyNumber, vatNumber } = settings;
const linkColumns = [footer.column3, footer.column4].filter((column) => column?.links?.length);

const linkClass = 'text-sm leading-5 text-white/70 hover:text-bsw-orange transition-colors';
const headingClass = 'text-sm leading-5 font-bold text-white';
---

<footer class='bg-bsw-navy mx-4 mb-4 rounded-2xl py-15 md:py-21.25 print:hidden'>
	<div class='content-wrapper'>
		<div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-5 gap-y-10 pb-11.25 border-b border-white/15'>
			<!-- Logo & tagline -->
			<div class='flex flex-col gap-8.25'>
				<a href='/' aria-label='BSW Heating home'>
					<Image src={BswLogo} alt='BSW Heating' class='w-35 h-auto' />
				</a>
				{footer.column1?.description && <p class='text-sm leading-5.25 text-white/70 max-w-60'>{footer.column1.description}</p>}
			</div>

			<!-- Location & contact -->
			<div class='flex flex-col gap-3 lg:py-3.25'>
				<p class={headingClass}>{footer.column2?.heading ?? 'Location & Contact'}</p>
				<address class='not-italic text-sm leading-5.25 text-white/70 py-1'>
					{addressLine1}<br />
					{addressLine2}
				</address>
				{phone && <div><a class={linkClass} href={telHref(phone)}>{phone}</a></div>}
				{email && <div><a class={linkClass} href={`mailto:${email}`}>{email}</a></div>}
			</div>

			<!-- Link columns -->
			{
				linkColumns.map((column) => (
					<div class='flex flex-col gap-3 lg:py-3.25'>
						{column?.heading && <p class={headingClass}>{column.heading}</p>}
						{column?.links?.map((link) => (
							<div>
								<a
									class={linkClass}
									href={link.href}
									target={link.newTab ? '_blank' : undefined}
									rel={link.newTab ? 'noopener' : undefined}>
									{link.label}
								</a>
							</div>
						))}
					</div>
				))
			}
		</div>

		<!-- Copyright -->
		<div class='pt-12.75 flex flex-col gap-2.5 text-white/55'>
			<p class='text-sm leading-5.25'>© Copyright BSW Heating {today.getFullYear()}</p>
			<p class='text-[13px] leading-5'>
				{`BSW Heating Ltd, ${addressLine1} ${addressLine2}. Registered in England (${companyNumber}). VAT No: ${vatNumber}`}
			</p>
		</div>
	</div>
</footer>
