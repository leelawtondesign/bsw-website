---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	title: string;
	subtitle?: string;
	image?: ImageMetadata;
	variant?: 'navy' | 'orange';
}

const { title, subtitle, image, variant = 'navy' } = Astro.props;
---

<section
	class:list={[
		'mx-4 rounded-[19px] overflow-hidden relative lg:min-h-94.25 flex',
		variant === 'orange' ? 'bg-gradient-orange' : 'bg-bsw-navy',
	]}>
	{
		image && (
			<>
				<Image
					src={image}
					alt=''
					widths={[640, 1280, 1920, 2528]}
					sizes='100vw'
					quality={80}
					loading='eager'
					fetchpriority='high'
					class='hero-image absolute inset-0 w-full h-full object-cover object-[60%_40%] pointer-events-none'
				/>
				<div class='absolute inset-0 bg-linear-to-t from-[rgba(29,38,49,0.89)] from-[9.5%] to-[rgba(38,50,65,0.1)] to-[123%] pointer-events-none' />
			</>
		)
	}

	<div
		class:list={[
			'content-wrapper relative z-10 hero-content flex flex-col gap-3 text-white pt-36 pb-12',
			image ? 'items-start lg:pt-54.5 lg:pb-15.5' : 'items-center text-center lg:pt-47.25 lg:pb-23',
		]}>
		<h1>{title}</h1>
		{subtitle && <p class='text-lg leading-7 max-w-118'>{subtitle}</p>}
	</div>
</section>
