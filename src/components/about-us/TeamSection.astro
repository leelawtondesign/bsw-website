---
import TeamCard from '../TeamCard.astro';
import { loadQuery } from '../../sanity/lib/load-query';
import { IMAGE, type SanityImage } from '../../sanity/lib/image';

interface Props {
	heading?: string;
	text?: string;
}

const { heading = 'Executive Board', text } = Astro.props;

interface TeamMember {
	name: string;
	role: string;
	photo: SanityImage;
}

const { data } = await loadQuery<TeamMember[]>({
	query: `*[_type == "teamMember" && defined(photo.asset)] | order(orderRank) { name, role, photo${IMAGE} }`,
});

const team = data ?? [];
---

{team.length > 0 && (
<section class='bg-light-grey-bg mx-4 rounded-2xl py-15 md:py-20'>
	<div class='content-wrapper'>
		<div class='text-center flex flex-col gap-3 max-w-158.5 mx-auto mb-9.75'>
			<h2 class='text-text-primary'>{heading}</h2>
			{text && <p class='text-lg leading-7 text-text-secondary'>{text}</p>}
		</div>

		<div class='grid grid-cols-12 gap-3.75'>
			{
				team.map((member) => (
					<div class='col-span-12 sm:col-span-6 lg:col-span-3'>
						<TeamCard name={member.name} role={member.role} image={member.photo} />
					</div>
				))
			}
		</div>
	</div>
</section>
)}
