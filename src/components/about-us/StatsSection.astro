---
const stats = [
	{ value: '25+', label: 'Years experience' },
	{ value: '50k+', label: 'Dwellings serviced' },
	{ value: '550+', label: 'Plant rooms managed' },
	{ value: '98%', label: 'Client retention' },
];
---

<section class='bg-light-grey-bg py-15 md:py-20'>
	<div class='content-wrapper'>
		<dl class='grid grid-cols-2 md:grid-cols-4 gap-y-10 max-w-246 mx-auto text-center'>
			{
				stats.map((stat) => (
					<div class='flex flex-col-reverse items-center'>
						<dt class='text-sm font-medium leading-5 text-text-secondary'>{stat.label}</dt>
						<dd class='text-4xl font-bold leading-12 text-bsw-orange-text'>{stat.value}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
