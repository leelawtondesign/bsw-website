---
import ValueCard from '../ValueCard.astro';

const values = [
	{
		title: 'Reliability',
		description: 'Gas Safe engineers providing scheduled and 24/7 emergency cover, year round.',
	},
	{
		title: 'Partnership',
		description: 'Long-term relationships with housing associations, councils and public bodies.',
	},
	{
		title: 'Compliance',
		description: 'Fully accredited, in-house administrative and engineering teams supporting every contract.',
	},
];
---

<section class='content-wrapper py-15 md:py-20'>
	<div class='text-center flex flex-col gap-3 mb-9.75'>
		<p class='uppercase-tag text-bsw-orange-text'>Our values</p>
		<h2 class='text-text-primary'>What Drives Us</h2>
	</div>

	<div class='grid grid-cols-12 gap-y-3.75 md:gap-x-7.5'>
		{
			values.map((value, index) => (
				<div class='col-span-12 md:col-span-4'>
					<ValueCard number={String(index + 1).padStart(2, '0')} title={value.title} description={value.description} />
				</div>
			))
		}
	</div>
</section>
