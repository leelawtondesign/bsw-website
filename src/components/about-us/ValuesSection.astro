---
import ValueCard from '../ValueCard.astro';

interface Props {
	heading?: string;
	values?: { _key: string; title: string; description?: string }[];
}

const { heading = 'What Drives Us', values = [] } = Astro.props;
---

{values.length > 0 && (
<section class='content-wrapper py-15 md:py-20'>
	<div class='text-center mb-9.75'>
		<h2 class='text-text-primary'>{heading}</h2>
	</div>

	<div class='grid grid-cols-12 gap-y-3.75 md:gap-x-7.5'>
		{
			values.map((value, index) => (
				<div class='col-span-12 md:col-span-4'>
					<ValueCard number={String(index + 1).padStart(2, '0')} title={value.title} description={value.description ?? ''} />
				</div>
			))
		}
	</div>
</section>
)}
