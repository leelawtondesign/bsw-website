---
import { Play } from '@lucide/astro';
import Button from '../Button.astro';
import HelpStepCard from '../HelpStepCard.astro';
import type { SanityImage } from '../../sanity/lib/image';

interface Props {
	heading?: string;
	steps?: { _key: string; title: string; description?: string; image?: SanityImage }[];
	winterAdvice?: { heading?: string; text?: string; videoUrl?: string };
}

const { heading, steps = [], winterAdvice } = Astro.props;
---

<section class='content-wrapper pt-15 pb-12.5 md:pt-18.75'>
	{heading && <h2 class='text-text-primary text-center max-w-154 mx-auto mb-10 md:mb-13.75'>{heading}</h2>}

	<ol class='flex flex-col gap-6 md:gap-10'>
		{
			steps.map((step) => (
				<li>
					<HelpStepCard title={step.title} description={step.description} image={step.image} />
				</li>
			))
		}
		{
			winterAdvice?.heading && (
				<li class='border border-grey-200 rounded-2xl px-6 py-10 md:px-16 md:py-13 flex flex-col items-center gap-5.5 text-center'>
					<div class='flex flex-col gap-1.75'>
						<h3 class='text-h4 text-text-primary'>{winterAdvice.heading}</h3>
						{winterAdvice.text && <p class='text-lg leading-7 text-text-secondary'>{winterAdvice.text}</p>}
					</div>
					{winterAdvice.videoUrl && (
						<Button variant='dark' href={winterAdvice.videoUrl} target='_blank'>
							<Play size={20} class='fill-white' stroke-width={1.5} />
							Watch on YouTube
						</Button>
					)}
				</li>
			)
		}
	</ol>
</section>
