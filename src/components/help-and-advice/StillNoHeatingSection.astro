---
import { Phone } from '@lucide/astro';
import Button from '../Button.astro';
import { getSiteSettings, telHref } from '../../sanity/lib/globals';

interface Props {
	heading?: string;
	text?: string;
}

const { heading = 'Still no heating or hot water?', text } = Astro.props;
const { phone } = await getSiteSettings();
---

<section class='bg-bsw-orange mx-4 rounded-2xl py-15 md:py-20 mb-6.25'>
	<div class='content-wrapper flex flex-col items-center gap-5.5 text-center text-white'>
		<div class='flex flex-col gap-1.75 max-w-139'>
			<h2 class='text-h4'>{heading}</h2>
			{text && <p class='text-lg leading-7'>{text}</p>}
		</div>
		{
			phone && (
				<Button variant='white' href={telHref(phone)}>
					<Phone size={20} stroke-width={1.5} />
					{phone}
				</Button>
			)
		}
	</div>
</section>
