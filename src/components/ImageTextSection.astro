---
import type { SanityImage } from '../sanity/lib/image';
import { Image } from 'astro:assets';

interface Props {
	tag?: string;
	heading?: string;
	image?: SanityImage;
	imagePosition?: 'left' | 'right';
	class?: string;
}

const { tag, heading, image, imagePosition = 'left', class: className = 'py-15 md:py-25' } = Astro.props;
---

<section class={`content-wrapper ${className}`}>
	<div class='grid grid-cols-12 gap-y-10 md:gap-x-10 lg:gap-x-0 items-center'>
		<!-- Image -->
		<div
			class:list={[
				'col-span-12 md:col-span-6 lg:col-span-5 rounded-2xl overflow-hidden aspect-455/368',
				imagePosition === 'right' && 'md:order-2 lg:col-start-8',
			]}>
			{image && <Image
				src={image.url}
				width={image.width}
				height={image.height}
				alt={image.alt ?? ''}
				widths={[480, 960, 1440]}
				sizes='(min-width: 1024px) 455px, (min-width: 768px) 50vw, 100vw'
				quality={80}
				class='w-full h-full object-cover'
			/>}
		</div>

		<!-- Copy -->
		<div
			class:list={[
				'col-span-12 md:col-span-6 flex flex-col items-start gap-6.5',
				imagePosition === 'right' ? 'md:order-1 lg:col-start-1' : 'lg:col-start-7',
			]}>
			{tag && <p class='uppercase-tag text-bsw-orange-text'>{tag}</p>}
			{heading && <h2 class='text-text-primary'>{heading}</h2>}
			<div class='text-text-primary max-w-114 flex flex-col gap-4'>
				<slot />
			</div>
		</div>
	</div>
</section>
